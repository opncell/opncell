{% set cellular = (OPNsense | default({})).get('opncell') or {} %}
{% set general = cellular.get('general') or {} %}
{% if general.get('enablefour') == "1" or general.get('enablefiveNSA') == "1"  %}
epchssd_enable="YES"
epchssd_setup="/usr/local/opnsense/scripts/opncell/epchssd_setup.sh"
{% else %}
epchssd_enable="NO"
{% endif %}
