{% set cellular = (OPNsense | default({})).get('opncell') or {} %}
{% set general = cellular.get('general') or {} %}
{% if general.get('enablefiveSA') == '1' or general.get('enablefour') == '1'  or general.get('enablefiveNSA') == '1' %}
epcscpd_enable="YES"
epcscpd_setup="/usr/local/opnsense/scripts/opncell/epcscpd_setup.sh"
{% else %}
epcscpd_enable="NO"
{% endif %}
