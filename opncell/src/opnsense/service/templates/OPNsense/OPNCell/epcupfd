{% set cellular = (OPNsense | default({})).get('opncell') or {} %}
{% set general = cellular.get('general') or {} %}
{% if general.get('enablefour') == "1" or general.get('enablefiveNSA') == "1"  or general.get('enableupf') == '1'  or general.get('enablefiveSA') == '1' %}
epcupfd_enable="YES"
epcupfd_setup="/usr/local/opnsense/scripts/opncell/epcupfd_setup.sh"
{% else %}
epcupfd_enable="NO"
{% endif %}