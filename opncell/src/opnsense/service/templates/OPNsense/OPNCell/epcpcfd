{% set cellular = (OPNsense | default({})).get('opncell') or {} %}
{% set general = cellular.get('general') or {} %}
{% if general.get('enablefiveSA') == '1' or general.get('enableupf') == '1' %}
epcpcfd_enable="YES"
epcpcfd_setup="/usr/local/opnsense/scripts/opncell/epcpcfd_setup.sh"
{% else %}
epcpcfd_enable="NO"
{% endif %}
