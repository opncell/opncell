#!/bin/sh

echo "=====> "
echo "Enabling SCTP support ..."

touch /boot/loader.conf.local
# shellcheck disable=SC2129

if ! grep -q "DEVELOPER=yes" /etc/make.conf; then
    echo "DEVELOPER=yes" >> /etc/make.conf
fi

values='hw.ixgbe.unsupported_sfp=1 hw.ix.unsupported_sfp=1 hw.if_ix_updated.unsupported_sfp=1 if_ix_updated_load="YES" sctp_load="YES"'

for val in $values; do
    if ! grep -q "$val" /boot/loader.conf.local; then
        echo "$val" >> /boot/loader.conf.local
    fi
done

kldload sctp.ko

# ============================================
# Raise kern.ipc.maxsockbuf for open5gs SCTP sockets
# ============================================
# open5gs' S1AP (mmed) and NGAP (amfd) interfaces open SCTP sockets. The
# FreeBSD SCTP stack computes its default send/recv buffer size at boot from
# the kernel's compiled-in SB_MAX constant, independent of the *live*
# kern.ipc.maxsockbuf ceiling - on stock FreeBSD 14/15 those two numbers can
# disagree, and when the default maxsockbuf ceiling ends up smaller than what
# SCTP requests, socket() fails with ENOBUFS ("No buffer space available")
# and the daemon aborts before it can bind its S1AP/NGAP listener. This is a
# known FreeBSD/OPNsense base-tuning gap, not an open5gs bug - see e.g.
# opnsense/plugins#5422, where FRR hit the identical symptom.
#
# kern.ipc.maxsockbuf has no loader-tunable hook (it can't be set via
# /boot/loader.conf), so it has to go through OPNsense's own Tunables model
# (System > Settings > Tunables / config.xml <sysctl>) rather than a raw
# /etc/sysctl.conf edit, which OPNsense's config sync would otherwise
# overwrite on the next boot or config apply.
echo "=====> "
echo "Raising kern.ipc.maxsockbuf for open5gs SCTP (S1AP/NGAP) sockets ..."

sockbuf_target=33554432 # 32 MiB - matches the value OPNsense's FRR plugin settled on for the same issue

cat > /tmp/opncell_set_maxsockbuf.php <<'PHP_EOF'
<?php
require_once('config.inc');

use OPNsense\Core\Config;
use OPNsense\Core\Tunables;

$tunable = 'kern.ipc.maxsockbuf';
$target = 33554432; // keep in sync with sockbuf_target above
$descr = 'Required by OPNcell/open5gs SCTP sockets (S1AP/NGAP) - default maxsockbuf is smaller than what the kernel SCTP stack requests, causing ENOBUFS on socket creation.';

$mdl = new Tunables();
$node = null;

foreach ($mdl->item->iterateItems() as $item) {
    if ((string)$item->tunable === $tunable) {
        $node = $item;
        break;
    }
}

$current = $node !== null ? (string)$node->value : '';

if ($current !== '' && (int)$current >= $target) {
    // Already set high enough (by an admin, or a previous run) - leave it alone
    echo "ok: already {$current}\n";
    exit(0);
}

if ($node === null) {
    // No placeholder item for this tunable in config.xml - create one
    $node = $mdl->item->Add();
    $node->tunable = $tunable;
}

$node->descr = $descr;
$node->value = (string)$target;

$validations = $mdl->performValidation();
if ($validations->count() > 0) {
    foreach ($validations as $msg) {
        fwrite(STDERR, "validation error: " . $msg->getMessage() . "\n");
    }
    exit(1);
}

$mdl->serializeToConfig();
Config::getInstance()->save();
echo "set: {$target}\n";
PHP_EOF

if php -f /tmp/opncell_set_maxsockbuf.php; then
    # Regenerate /etc/sysctl.conf from config.xml and apply it now, the same
    # way OPNsense's own boot hook does (rc.syshook.d/start/90-sysctl)
    pluginctl -s sysctl restart >/dev/null 2>&1
else
    echo "WARNING: could not persist kern.ipc.maxsockbuf via config.xml - applying live only, this will not survive a reboot"
fi
rm -f /tmp/opncell_set_maxsockbuf.php

# Belt-and-suspenders: apply live right now regardless of the above, so this
# install doesn't need a reboot before open5gs can bind its SCTP sockets.
sysctl kern.ipc.maxsockbuf="$sockbuf_target"

if ! grep -q "DEVELOPER=yes" /etc/make.conf; then
    echo "DEVELOPER=yes" >> /etc/make.conf
fi

export LIBRARY_PATH=/usr/local/lib
export C_INCLUDE_PATH=/usr/local/include

echo "=====> "
echo "Disabling the packet filter ..."
pfctl -d

# We have a custom mongod file, hence we need to move the mongod file that ships with the
# mongod installation. This prevents the conflict when opncell tries to move the custom mongod file
# into /usr/local/etc/rc.d/ . We could rename our custom file to something else but :) Too many moving parts

mv /usr/local/etc/rc.d/mongod /usr/local/etc/rc.d/mongod.back

mv /usr/local/etc/rc.d/mongod_custom  /usr/local/etc/rc.d/mongod

mv /usr/local/etc/mongodb.conf /usr/local/etc/mongodb.conf.back

cp /usr/local/etc/rc.d/mongod  /usr/local/etc/rc.d/mongod_custom

cp /usr/local/etc/rc.d/mongodb_custom.conf  /usr/local/etc/mongodb.conf

chmod +x /usr/local/etc/rc.d/mongod

cd -

rm -rf /var/log/opncell

# ============================================
# Schedule open5gs library update
# ============================================
echo "=====> Scheduling open5gs lib update..."

(
    # Wait for current installation to complete
    sleep 10

    # Wait for pkg lock to be released
    while [ -f /var/run/pkg.lock ] || pgrep -x pkg >/dev/null; do
        sleep 5
    done

    # Perform reinstallation
    echo "Updating open5gs libraries... This might take some time."
    if pkg install -fyq open5gs >/dev/null 2>&1; then
        echo "Update completed successfully"
        exit 0
    else
        echo "Failed to reinstall open5gs"
        exit 1
    fi
) &



pgrep open5gs | xargs kill -9

checkMongo(){
    if pgrep mongod; then
         pid_mongod=$(pgrep mongod)
         kill -9 ${pid_mongod}
         rm -r /usr/local/bin/data/db  # Sometimes a new installation corrupts the db
         configctl mongod start
         sleep 5

         if pgrep open5gs-hssd; then
             pid_hss=$(pgrep open5gs-hssd)
             kill -9 ${pid_hss}
             configctl hssd start
         fi

   fi

  echo "=====> Getting mongosh client"
  if ! command -v mongosh >/dev/null 2>&1; then
      if pkg install -yq npm; then
          if npm install -g mongosh; then
              echo "mongosh installed"
          else
              echo "WARNING: mongosh install failed" >&2
          fi
      else
          echo "WARNING: could not install npm/mongosh" >&2
      fi
  fi

  # Disable mongosh telemetry globally. mongosh's per-user telemetry setup
  # writes to ~/.mongodb/mongosh/config on first run, which fails (e.g.
  # "Telemetry setup is missing userId or anonymousId") whenever $HOME isn't
  # a writable, existing directory - exactly the case here, since
  # opncell_db.sh invokes `npx mongosh` non-interactively as root via
  # configd/cron, not from an interactive login shell. The global config
  # file sidesteps that entirely: it's a one-time write, doesn't depend on
  # $HOME, and forceDisableTelemetry can't be flipped back on later (by a
  # script or an admin), unlike calling disableTelemetry() per-invocation.
  echo "=====> Disabling mongosh telemetry"
  cat > /etc/mongosh.conf <<'EOF'
mongosh:
  enableTelemetry: false
  forceDisableTelemetry: true
EOF

}


  echo "=====> Installation complete."
  echo "=====> The below Virtual IPs should be enabled on the loopback address via the GUI. These are required for the smooth running of open5gs services."
  echo "=====> To add them ----> Interfaces ----->Virtual IPs "
  echo "MongoDB   = 127.0.0.1 (subscriber data) - http://localhost:3000"
  echo "MME-s1ap  = 127.0.0.2 :36412 for S1-MME"
  echo "MME-gtpc  = 127.0.0.2 :2123 for S11"
  echo "MME-frDi  = 127.0.0.2 :3868 for S6a"
  echo "SGWC-gtpc = 127.0.0.3 :2123 for S11"
  echo "SGWC-pfcp = 127.0.0.3 :8805 for Sxa"
  echo "SMF-gtpc  = 127.0.0.4 :2123 for S5c, N11"
  echo "SMF-gtpu  = 127.0.0.4 :2152 for N4u (Sxu)"
  echo "SMF-pfcp  = 127.0.0.4 :8805 for N4 (Sxb)"
  echo "SMF-frDi  = 127.0.0.4 :3868 for Gx auth"
  echo "SMF-sbi   = 127.0.0.4 :7777 for 5G SBI (N7,N10,N11)"
  echo "AMF-ngap  = 127.0.0.5 :38412 for N2"
  echo "AMF-sbi   = 127.0.0.5 :7777 for 5G SBI (N8,N12,N11)"
  echo "SGWU-pfcp = 127.0.0.6 :8805 for Sxa"
  echo "SGWU-gtpu = 127.0.0.6 :2152 for S1-U, S5u"
  echo "UPF-pfcp  = 127.0.0.7 :8805 for N4 (Sxb)"
  echo "UPF-gtpu  = 127.0.0.7 :2152 for S5u, N3, N4u (Sxu) (needs to be changed to the interface hosting the xNBs)"
  echo "HSS-frDi  = 127.0.0.8 :3868 for S6a, Cx"
  echo "PCRF-frDi = 127.0.0.9 :3868 for Gx"
  echo "NRF-sbi   = 127.0.0.10:7777 for 5G SBI"
  echo "SCP-sbi   = 127.0.0.200:7777 for 5G SBI"
  echo "SEPP-sbi  = 127.0.0.250:7777 for 5G SBI"
  echo "SEPP-n32  = 127.0.0.251:7777 for 5G N32"
  echo "SEPP-n32f = 127.0.0.252:7777 for 5G N32-f"
  echo "AUSF-sbi  = 127.0.0.11:7777 for 5G SBI"
  echo "UDM-sbi   = 127.0.0.12:7777 for 5G SBI"
  echo "PCF-sbi   = 127.0.0.13:7777 for 5G SBI"
  echo "NSSF-sbi  = 127.0.0.14:7777 for 5G SBI"
  echo "BSF-sbi   = 127.0.0.15:7777 for 5G SBI"
  echo "UDR-sbi   = 127.0.0.20:7777 for 5G SBI"

values='mongod_enable="YES" epcmmed_enable="YES" epcamfd_enable="YES" epchssd_enable="YES" epcnrfd_enable="YES" epcnssfd_enable="YES" epcpcfd_enable="YES" epcbsfd_enable="YES" epcsmfd_enable="YES" epcupfd_enable="YES" epcsgwcd_enable="YES" epcsgwud_enable="YES" epcpcrfd_enable="YES" epcausfd_enable="YES" epcudmd_enable="YES" epcupfd_enable="YES" epcudrd_enable="YES" epcscpd_enable="YES"'

for val in $values; do
    if ! grep -q "$val" /etc/rc.conf; then
        echo "$val" >> /etc/rc.conf
    fi
done

#mkdir -p /root/data/db
echo "=====> Starting MongoDB and HSS service"
checkMongo

if ! service configd status >/dev/null 2>&1; then
  service configd restart
fi


exit 0