#!/bin/sh

# PROVIDE: open5gs_sgwc
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_sgwc_enable="YES"
#
# Optional:
# open5gs_sgwc_config="%%ETCDIR%%/sgwc.yaml"
# open5gs_sgwc_flags=""
#

. /etc/rc.subr

name="open5gs_sgwc"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_sgwc_enable:="NO"}
: ${open5gs_sgwc_config="%%ETCDIR%%/sgwc.yaml"}
: ${open5gs_sgwc_flags=""}

command="%%PREFIX%%/bin/open5gs-sgwcd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_sgwc_config}"

start_cmd="${name}_start"

open5gs_sgwc_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_sgwc_config}" \
	    ${open5gs_sgwc_flags}
}

run_rc_command "$1"
