#!/bin/sh

# PROVIDE: open5gs_nssf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_nssf_enable="YES"
#
# Optional:
# open5gs_nssf_config="%%ETCDIR%%/nssf.yaml"
# open5gs_nssf_flags=""
#

. /etc/rc.subr

name="open5gs_nssf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_nssf_enable:="NO"}
: ${open5gs_nssf_config="%%ETCDIR%%/nssf.yaml"}
: ${open5gs_nssf_flags=""}

command="%%PREFIX%%/bin/open5gs-nssfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_nssf_config}"

start_cmd="${name}_start"

open5gs_nssf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_nssf_config}" \
	    ${open5gs_nssf_flags}
}

run_rc_command "$1"
