#!/bin/sh

# PROVIDE: open5gs_nrf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_nrf_enable="YES"
#
# Optional:
# open5gs_nrf_config="%%ETCDIR%%/nrf.yaml"
# open5gs_nrf_flags=""
#

. /etc/rc.subr

name="open5gs_nrf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_nrf_enable:="NO"}
: ${open5gs_nrf_config="%%ETCDIR%%/nrf.yaml"}
: ${open5gs_nrf_flags=""}

command="%%PREFIX%%/bin/open5gs-nrfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_nrf_config}"

start_cmd="${name}_start"

open5gs_nrf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_nrf_config}" \
	    ${open5gs_nrf_flags}
}

run_rc_command "$1"
