#!/bin/sh

# PROVIDE: open5gs_sepp2
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_sepp2_enable="YES"
#
# Optional:
# open5gs_sepp2_config="%%ETCDIR%%/sepp2.yaml"
# open5gs_sepp2_flags=""
#

. /etc/rc.subr

name="open5gs_sepp2"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_sepp2_enable:="NO"}
: ${open5gs_sepp2_config="%%ETCDIR%%/sepp2.yaml"}
: ${open5gs_sepp2_flags=""}

command="%%PREFIX%%/bin/open5gs-sepp2d"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_sepp2_config}"

start_cmd="${name}_start"

open5gs_sepp2_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_sepp2_config}" \
	    ${open5gs_sepp2_flags}
}

run_rc_command "$1"
