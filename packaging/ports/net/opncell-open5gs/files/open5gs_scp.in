#!/bin/sh

# PROVIDE: open5gs_scp
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_scp_enable="YES"
#
# Optional:
# open5gs_scp_config="%%ETCDIR%%/scp.yaml"
# open5gs_scp_flags=""
#

. /etc/rc.subr

name="open5gs_scp"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_scp_enable:="NO"}
: ${open5gs_scp_config="%%ETCDIR%%/scp.yaml"}
: ${open5gs_scp_flags=""}

command="%%PREFIX%%/bin/open5gs-scpd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_scp_config}"

start_cmd="${name}_start"

open5gs_scp_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_scp_config}" \
	    ${open5gs_scp_flags}
}

run_rc_command "$1"
