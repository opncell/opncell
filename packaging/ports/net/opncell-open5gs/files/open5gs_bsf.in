#!/bin/sh

# PROVIDE: open5gs_bsf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_bsf_enable="YES"
#
# Optional:
# open5gs_bsf_config="%%ETCDIR%%/bsf.yaml"
# open5gs_bsf_flags=""
#

. /etc/rc.subr

name="open5gs_bsf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_bsf_enable:="NO"}
: ${open5gs_bsf_config="%%ETCDIR%%/bsf.yaml"}
: ${open5gs_bsf_flags=""}

command="%%PREFIX%%/bin/open5gs-bsfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_bsf_config}"

start_cmd="${name}_start"

open5gs_bsf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_bsf_config}" \
	    ${open5gs_bsf_flags}
}

run_rc_command "$1"
