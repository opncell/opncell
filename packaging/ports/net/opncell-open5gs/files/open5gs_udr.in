#!/bin/sh

# PROVIDE: open5gs_udr
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_udr_enable="YES"
#
# Optional:
# open5gs_udr_config="%%ETCDIR%%/udr.yaml"
# open5gs_udr_flags=""
#

. /etc/rc.subr

name="open5gs_udr"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_udr_enable:="NO"}
: ${open5gs_udr_config="%%ETCDIR%%/udr.yaml"}
: ${open5gs_udr_flags=""}

command="%%PREFIX%%/bin/open5gs-udrd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_udr_config}"

start_cmd="${name}_start"

open5gs_udr_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_udr_config}" \
	    ${open5gs_udr_flags}
}

run_rc_command "$1"
