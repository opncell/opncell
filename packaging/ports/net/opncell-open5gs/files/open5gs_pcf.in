#!/bin/sh

# PROVIDE: open5gs_pcf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_pcf_enable="YES"
#
# Optional:
# open5gs_pcf_config="%%ETCDIR%%/pcf.yaml"
# open5gs_pcf_flags=""
#

. /etc/rc.subr

name="open5gs_pcf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_pcf_enable:="NO"}
: ${open5gs_pcf_config="%%ETCDIR%%/pcf.yaml"}
: ${open5gs_pcf_flags=""}

command="%%PREFIX%%/bin/open5gs-pcfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_pcf_config}"

start_cmd="${name}_start"

open5gs_pcf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_pcf_config}" \
	    ${open5gs_pcf_flags}
}

run_rc_command "$1"
