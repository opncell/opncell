#!/bin/sh

# PROVIDE: open5gs_hss
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_hss_enable="YES"
#
# Optional:
# open5gs_hss_config="%%ETCDIR%%/hss.yaml"
# open5gs_hss_flags=""
#

. /etc/rc.subr

name="open5gs_hss"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_hss_enable:="NO"}
: ${open5gs_hss_config="%%ETCDIR%%/hss.yaml"}
: ${open5gs_hss_flags=""}

command="%%PREFIX%%/bin/open5gs-hssd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_hss_config}"

start_cmd="${name}_start"

open5gs_hss_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_hss_config}" \
	    ${open5gs_hss_flags}
}

run_rc_command "$1"
