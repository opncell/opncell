#!/bin/sh

# PROVIDE: open5gs_smf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_smf_enable="YES"
#
# Optional:
# open5gs_smf_config="%%ETCDIR%%/smf.yaml"
# open5gs_smf_flags=""
#

. /etc/rc.subr

name="open5gs_smf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_smf_enable:="NO"}
: ${open5gs_smf_config="%%ETCDIR%%/smf.yaml"}
: ${open5gs_smf_flags=""}

command="%%PREFIX%%/bin/open5gs-smfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_smf_config}"

start_cmd="${name}_start"

open5gs_smf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_smf_config}" \
	    ${open5gs_smf_flags}
}

run_rc_command "$1"
