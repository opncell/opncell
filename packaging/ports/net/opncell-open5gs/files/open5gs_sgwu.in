#!/bin/sh

# PROVIDE: open5gs_sgwu
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_sgwu_enable="YES"
#
# Optional:
# open5gs_sgwu_config="%%ETCDIR%%/sgwu.yaml"
# open5gs_sgwu_flags=""
#

. /etc/rc.subr

name="open5gs_sgwu"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_sgwu_enable:="NO"}
: ${open5gs_sgwu_config="%%ETCDIR%%/sgwu.yaml"}
: ${open5gs_sgwu_flags=""}

command="%%PREFIX%%/bin/open5gs-sgwud"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_sgwu_config}"

start_cmd="${name}_start"

open5gs_sgwu_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_sgwu_config}" \
	    ${open5gs_sgwu_flags}
}

run_rc_command "$1"
