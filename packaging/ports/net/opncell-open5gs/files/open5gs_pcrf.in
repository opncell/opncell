#!/bin/sh

# PROVIDE: open5gs_pcrf
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_pcrf_enable="YES"
#
# Optional:
# open5gs_pcrf_config="%%ETCDIR%%/pcrf.yaml"
# open5gs_pcrf_flags=""
#

. /etc/rc.subr

name="open5gs_pcrf"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_pcrf_enable:="NO"}
: ${open5gs_pcrf_config="%%ETCDIR%%/pcrf.yaml"}
: ${open5gs_pcrf_flags=""}

command="%%PREFIX%%/bin/open5gs-pcrfd"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_pcrf_config}"

start_cmd="${name}_start"

open5gs_pcrf_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_pcrf_config}" \
	    ${open5gs_pcrf_flags}
}

run_rc_command "$1"
