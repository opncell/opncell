#!/bin/sh

# PROVIDE: open5gs_mme
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following to /etc/rc.conf to enable:
#
# open5gs_amf_enable="YES"
#
# Optional:
# open5gs_mme_config="%%ETCDIR%%/mme.yaml"
# open5gs_mme_flags=""
#

. /etc/rc.subr

name="open5gs_mme"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${open5gs_mme_enable:="NO"}
: ${open5gs_mme_config="%%ETCDIR%%/mme.yaml"}
: ${open5gs_mme_flags=""}

command="%%PREFIX%%/bin/open5gs-mmed"
procname="${command}"
pidfile="/var/run/${name}.pid"

required_files="${open5gs_mme_config}"

start_cmd="${name}_start"

open5gs_mme_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "${pidfile}" \
	    "${command}" \
	    -c "${open5gs_mme_config}" \
	    ${open5gs_mme_flags}
}

run_rc_command "$1"
