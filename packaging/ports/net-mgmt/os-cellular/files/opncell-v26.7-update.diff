+type:script_output
+message:Starting mongoDB
+
+[restartMongo]
+command:/usr/local/opnsense/scripts/opncell/startMongo.sh
+type:script_output
+message:Restarting mongoDB
+
+[stopMongo]
+command:/usr/local/opnsense/scripts/opncell/stopMongo.sh
+type:script
+message:Stopping mongoDB
+
+[saveTuneables]
