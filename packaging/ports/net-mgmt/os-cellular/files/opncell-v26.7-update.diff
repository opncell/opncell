+#!/usr/local/bin/python3
+
+import json
+import re
+import subprocess
+import sys
+
+
+def main():
+    result = "failed"
+    try:
+        data = json.loads(sys.argv[1])
+        if isinstance(data, list) and len(data) == 1:
+            data = data[0]
+        imsi = data["imsi"]
+        if re.fullmatch(r"[0-9]{5,15}", imsi):
+            output = subprocess.check_output(
+                ["/usr/local/opnsense/scripts/opncell/opncell_db.sh", "remove", imsi],
+                text=True,
+            ).strip()
+            if output == "1":
+                result = "deleted"
+            elif output == "0":
+                result = "not found"
+    except (IndexError, KeyError, TypeError, ValueError, OSError, subprocess.CalledProcessError):
+        pass
+    print(json.dumps(result))
+
+
+if __name__ == "__main__":
+    main()
