+int
+fd_peer_get_state_byid(
+    DiamId_t diamid,
+    size_t diamidlen,
+    int igncase,
+    int *state)
+{
+    struct fd_list *li;
+    struct fd_peer *peer = NULL;
+
+    TRACE_ENTRY("%p %zd %d %p",
+        diamid,
+        diamidlen,
+        igncase,
+        state);
+
+    CHECK_PARAMS(
+        diamid &&
+        diamidlen &&
+        state);
+
+    CHECK_POSIX(
+        pthread_rwlock_rdlock(
+            &fd_g_peers_rw));
+
+    if (igncase) {
+        for (li = fd_g_peers.next;
+             li != &fd_g_peers;
+             li = li->next) {
+            struct fd_peer *next;
+            int cmp;
+            int cont;
+
+            next = (struct fd_peer *)li;
+
+            cmp = fd_os_almostcasesrch(
+                diamid,
+                diamidlen,
+                next->p_hdr.info.pi_diamid,
+                next->p_hdr.info.pi_diamidlen,
+                &cont);
+
+            if (cmp == 0) {
+                peer = next;
+                break;
+            }
+
+            if (!cont)
+                break;
+        }
+    } else {
+        for (li = fd_g_peers.next;
+             li != &fd_g_peers;
+             li = li->next) {
+            struct fd_peer *next;
+            int cmp;
+
+            next = (struct fd_peer *)li;
+
+            cmp = fd_os_cmp(
+                diamid,
+                diamidlen,
+                next->p_hdr.info.pi_diamid,
+                next->p_hdr.info.pi_diamidlen);
+
+            if (cmp > 0)
+                continue;
+
+            if (cmp == 0)
+                peer = next;
+
+            break;
+        }
+    }
+
+    if (peer == NULL) {
+        CHECK_POSIX(
+            pthread_rwlock_unlock(
+                &fd_g_peers_rw));
+
+        return ENOENT;
+    }
+
+    *state = fd_peer_getstate(peer);
+
+    CHECK_POSIX(
+        pthread_rwlock_unlock(
+            &fd_g_peers_rw));
+
+    return 0;
+}
 
