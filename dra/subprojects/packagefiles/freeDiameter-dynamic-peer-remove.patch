+/*
+ * Request removal of a peer from the global peer table.
+ *
+ * If the peer is still active, its state machine is asked to terminate
+ * and EAGAIN is returned. The caller may retry later.
+ *
+ * Once the peer reaches STATE_ZOMBIE, this function unlinks and frees
+ * the peer object and returns 0. After that, the same Diameter Identity
+ * may be added again with fd_peer_add().
+ *
+ * Returns:
+ *   0       peer removed
+ *   EAGAIN  termination in progress
+ *   ENOENT  peer not found
+ *   EINVAL  invalid parameters
+ */
+int fd_peer_remove(
+    DiamId_t diamid,
+    size_t diamidlen);
