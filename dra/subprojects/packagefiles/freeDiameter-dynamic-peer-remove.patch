+/* Remove a peer */
+int
+fd_peer_remove(
+    DiamId_t diamid,
+    size_t diamidlen)
+{
+    struct fd_list *li;
+    struct fd_peer *peer = NULL;
+    int state;
+
+    TRACE_ENTRY("%p %zd", diamid, diamidlen);
+
+    CHECK_PARAMS(diamid && diamidlen);
+
+    CHECK_POSIX(
+        pthread_rwlock_wrlock(&fd_g_peers_rw));
+
+    for (li = fd_g_peers.next;
+          li != &fd_g_peers;
+          li = li->next) {
+        struct fd_peer *next = (struct fd_peer *)li;
+        int cmp;
+        int cont;
+
+        cmp = fd_os_almostcasesrch(
+            diamid,
+            diamidlen,
+            next->p_hdr.info.pi_diamid,
+            next->p_hdr.info.pi_diamidlen,
+            &cont);
+
+        if (cmp == 0) {
+            peer = next;
+            break;
+        }
+
+        if (!cont)
+            break;
+    }
 
+    if (peer == NULL) {
+        CHECK_POSIX(
+            pthread_rwlock_unlock(&fd_g_peers_rw));
+        return ENOENT;
+    }
+
+    state = fd_peer_getstate(peer);
+
+    if (state != STATE_ZOMBIE) {
+        peer->p_flags.pf_delete = 1;
+
+        CHECK_FCT_DO(
+            fd_psm_terminate(
+                peer,
+                "OPNCELL_DRA_REMOVE"),
+            {
+                pthread_rwlock_unlock(
+                    &fd_g_peers_rw);
+                return EINVAL;
+            });
+
+        CHECK_POSIX(
+            pthread_rwlock_unlock(&fd_g_peers_rw));
+
+        return EAGAIN;
+    }
+
+    fd_list_unlink(&peer->p_hdr.chain);
+
+    CHECK_POSIX(
+        pthread_rwlock_unlock(&fd_g_peers_rw));
+
+    CHECK_FCT(fd_peer_free(&peer));
+
+    return 0;
+}
